# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Run outputs
out/
runs/
*.pt
*.zip
*.pkl

# Video and image products
*.mp4
*.webm
*.gif
*.avi

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Local notes — never committed, so nothing lands in public history
notes/

# Trained policies: the working directory stays out, but the 17 policies from a
# committed search are evidence -- run.json records their paths as runs/<id>/
# policy.zip, so they are tracked in place rather than copied, which keeps those
# recorded paths valid and lets anyone replay a result with watch_policy.py.
!runs/
runs/*
!runs/seed*/
!runs/seed*/*/
!runs/seed*/*/policy.zip
# Since --run-id, a search nests one level deeper:
#   runs/<run-id>/seed<N>/<candidate>/policy.zip
!runs/*/
!runs/*/seed*/
!runs/*/seed*/*/
runs/*/seed*/*/*
!runs/*/seed*/*/policy.zip

# Scratch explanation written for the user, not part of the project
block_diagram.md

# Rendered video: regenerate with record_clip commands in README
clips/*.mp4
!clips/koda_submission.mp4
